# Server-only Campus Gear API base URL, including the /api prefix.
CAMPUS_GEAR_API_URL=http://localhost:8080/api

# Currency used to display backend prices. Keep it aligned with the backend's
# STRIPE_CURRENCY (defaults to USD) so shown totals match what Stripe charges.
CAMPUS_GEAR_CURRENCY=USD

# Server-only Cloudinary credentials for signed gear-image uploads.
# Never prefix these values with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional; defaults to campus-gear/gear.
CLOUDINARY_GEAR_FOLDER=campus-gear/gear
